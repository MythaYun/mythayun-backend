# Railway Environment Configuration Template
# Copy these variables to Railway dashboard for each environment

# === GENERAL CONFIGURATION ===
TZ=UTC
PORT=3333
HOST=0.0.0.0
APP_KEY=<set-in-railway-dashboard>
JWT_SECRET=<set-in-railway-dashboard>

# === ENVIRONMENT SPECIFIC ===
# For STAGING: NODE_ENV=staging, LOG_LEVEL=info
# For PRODUCTION: NODE_ENV=production, LOG_LEVEL=warn
NODE_ENV=production
LOG_LEVEL=warn

# === DATABASE CONFIGURATION ===
# Railway will automatically provide these variables:
# DATABASE_URL (use this OR the individual variables below)
# PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE

# AdonisJS Database Configuration
DB_CONNECTION=postgres
# Use Railway's DATABASE_URL or individual variables
# DB_HOST will be set by Railway as PGHOST
# DB_PORT will be set by Railway as PGPORT  
# DB_USER will be set by Railway as PGUSER
# DB_PASSWORD will be set by Railway as PGPASSWORD
# DB_DATABASE will be set by Railway as PGDATABASE

# === SESSION CONFIGURATION ===
SESSION_DRIVER=cookie

# === JWT CONFIGURATION ===
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# === FOOTBALL DATA PROVIDER ===
# goal-api.com is used when GOAL_API_KEY is set; API-Football otherwise.
GOAL_API_KEY=<set-in-railway-dashboard>
# Optional: goal-api league IDs (default: top 5 European leagues, Champions
# League, Botola Pro). Find IDs with GET https://api.goal-api.com/v1/leagues?search=
# GOAL_API_LEAGUE_IDS=
# Optional: seconds to cache data while a match is live (default 120).
# Lower it on a paid plan for fresher live scores.
# GOAL_API_LIVE_TTL_SECONDS=120
MOCK_API=false

# API-Football (only used when GOAL_API_KEY is not set)
# API_FOOTBALL_KEY=<set-in-railway-dashboard>
# AF_SEASON=2026
# AF_LEAGUE_SLUGS=39,140,78,135,61

# CORS: comma-separated browser origins allowed to call the API.
# `*` matches one subdomain label (for Vercel preview deploys).
CORS_ORIGINS=https://your-app.vercel.app,https://your-app-*.vercel.app

# Social login (server-side only; never put these in the frontend)
GOOGLE_CLIENT_ID=<set-in-railway-dashboard>
GOOGLE_CLIENT_SECRET=<set-in-railway-dashboard>
FACEBOOK_APP_ID=<set-in-railway-dashboard>
FACEBOOK_APP_SECRET=<set-in-railway-dashboard>
